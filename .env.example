# ============================================================================
# FastAPI Pydantic AI Agent - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values
# Required fields must be set or the application will fail to start

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# API key for X-API-Key authentication
# Used to protect API endpoints (except /health)
API_KEY=your-api-key-here

# Secret key used to HMAC-sign server-issued session ids, binding them to
# the authenticated principal so a request presenting another principal's
# session_id is rejected with 403 (Req 11.1/11.2)
# Generate one with: openssl rand -hex 32
# SECURITY: this placeholder is rejected at startup - a known signing key
# would let anyone forge session ids for any principal.
SESSION_SIGNING_KEY=replace-me

SESSION_MAX_MESSAGES=1000

# max-age (seconds) for the Strict-Transport-Security header, sent only over HTTPS
HSTS_MAX_AGE=31536000
# Whether Strict-Transport-Security includes includeSubDomains
HSTS_INCLUDE_SUBDOMAINS=true
# Confirms the ASGI server's forwarded-allow-ips trusts the TLS-terminating proxy
TRUST_PROXY_HEADERS=false

# LLM model identifier
# Examples: "openai:gpt-4o", "openai:gpt-4o-mini", "anthropic:claude-3-5-sonnet"
LLM_MODEL=openai:gpt-4o

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# API key for LLM provider
# Required for cloud providers (OpenAI, Anthropic)
# Not required for local providers (Ollama) - leave empty if using Ollama
LLM_API_KEY=sk-...

# Custom base URL for LLM provider
# Use for local providers or proxies
# For Ollama, use http://localhost:11434 (WITHOUT /v1)
#   LiteLLM automatically appends /v1 when making requests to Ollama
# Example for Ollama: http://localhost:11434
# Leave empty for default cloud provider endpoints
LLM_BASE_URL=

# Additional 'provider:model' identifiers tried in order if LLM_MODEL's
# provider fails (comma-separated or JSON array). Empty by default (no
# fallback chain beyond LLM_MODEL itself).
LLM_FALLBACK_MODELS=

# Optional independent 'provider:model' identifier for the evals judge
# (Req 6.4). When unset, the judge grades the agent under test with its own
# model (LLM_MODEL), which defeats the self-evaluation-bias mitigation the
# Judge[T] protocol exists to provide - the judge logs an AUDIT warning in
# this case. If set to a different provider than LLM_MODEL, that provider's
# key must be reachable via LLM_API_KEY too, since there is currently only
# one LLM_API_KEY for all configured models (LLM_MODEL, LLM_FALLBACK_MODELS,
# and JUDGE_MODEL alike).
JUDGE_MODEL=

# Vector store backend selection
# Options: "memory" (default, TF-IDF, no external dependency), "chroma"
#   (ChromaDB embeddings), "ollama" (Ollama embeddings via EMBEDDING_MODEL/
#   EMBEDDING_BASE_URL below)
# "ollama" requires EMBEDDING_MODEL to be set
VECTOR_STORE_BACKEND=memory

# Embedding model identifier for semantic search
# Example: "all-MiniLM-L6-v2" (fast, 384-dimensional embeddings)
# Leave empty to use default TF-IDF vector store (no embeddings)
EMBEDDING_MODEL=

# Custom base URL for embedding provider
# Example for Ollama embeddings: http://localhost:11434
# Leave empty when using EMBEDDING_MODEL without custom endpoint
EMBEDDING_BASE_URL=

# Number of retries for Pydantic AI output validation
# Default: 3
MAX_OUTPUT_RETRIES=3

# Application environment (development, staging, production)
# Default: development
# SECURITY: enable_mock_tools cannot be enabled when APP_ENV=production
APP_ENV=development

# Enable mock tools (for development only, disable in production)
# Default: false
# SECURITY: Cannot be enabled when APP_ENV=production
ENABLE_MOCK_TOOLS=false

# Allowed CORS origins (comma-separated or JSON array)
# Default: ["http://localhost:3000"]
# Examples:
#   Single origin: CORS_ORIGINS=https://app.example.com
#   Multiple origins: CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
#   Development (all origins): CORS_ORIGINS=["*"]
# SECURITY: Use specific domains in production, never use "*" in production
CORS_ORIGINS=["http://localhost:3000"]

# Comma-separated Host header allow-list. '*' is rejected outside development (staging and production both).
ALLOWED_HOSTS=*

# Trusted proxy IP addresses or CIDR networks for X-Forwarded-For validation
# Default: [] (empty list - X-Forwarded-For header is never trusted)
# Only requests whose immediate peer falls inside one of these entries have
# their X-Forwarded-For header trusted. Within such a request the chain is
# walked right-to-left, skipping hops that are themselves listed here, so a
# client-supplied leftmost element can never become the rate-limit key.
# Examples:
#   Single proxy: TRUSTED_PROXIES=["10.0.0.1"]
#   Multiple proxies: TRUSTED_PROXIES=["10.0.0.1","10.0.0.2","192.168.1.1"]
#   CIDR network (VPC / CDN range): TRUSTED_PROXIES=["10.0.0.0/8"]
# SECURITY: list EVERY hop between the client and this service. A hop you omit
# is treated as a client, so its address becomes the rate-limit bucket key.
# SECURITY: Empty list prevents X-Forwarded-For spoofing attacks
TRUSTED_PROXIES=[]

# Rate limit string (e.g. "30/minute") applied per-route to LLM-invoking
# endpoints (chat, stream, RAG query), stricter than the global
# 1000/minute default
# Default: 30/minute
LLM_RATE_LIMIT=30/minute

# Seconds a /health/ready probe result is reused before dependencies are
# probed again. That endpoint is unauthenticated and its LLM check is a real,
# billable provider request, so this cache is what stops inbound request
# volume from becoming outbound provider volume - it is a cost control, not a
# latency optimisation. 0 disables caching (every request probes live).
# Default: 10
READINESS_PROBE_CACHE_TTL=10

# Maximum retry attempts for LLM API calls
# Default: 3
LLM_RETRY_MAX_ATTEMPTS=3

# Base delay in seconds for exponential backoff retries
# Default: 1.0
LLM_RETRY_BASE_DELAY=1.0

# Timeout in seconds for individual LLM agent execution
# Prevents indefinite hangs during LLM evaluation/synthesis
# Default: 30
# Range: 5-300
LLM_AGENT_TIMEOUT=30

# Timeout in seconds for the whole POST /v1/agent/chat request
# Aborts via asyncio.wait_for rather than hanging indefinitely
# Default: 60
# Range: 5-300
CHAT_REQUEST_TIMEOUT=60

# Maximum number of model requests allowed per guarded agent run
# pydantic-ai UsageLimits.request_limit
# Default: 50
# Range: 1-500
USAGE_REQUEST_LIMIT=50

# Maximum total tokens (input+output) allowed per guarded agent run
# Also gates the pre-tool-call budget check before any tool executes
# Default: 100000
# Leave empty to disable both checks
USAGE_TOTAL_TOKENS_LIMIT=100000

# Maximum number of tool calls allowed per guarded agent run
# pydantic-ai UsageLimits.tool_calls_limit
# Default: 20
# Leave empty to disable the check
USAGE_TOOL_CALLS_LIMIT=20

# Per-request output-token ceiling applied to every chat model request,
# primary or fallback (pydantic-ai ModelSettings.max_tokens)
# Default: 4096
LLM_MAX_OUTPUT_TOKENS=4096

# Sampling temperature applied to every chat model request,
# primary or fallback (pydantic-ai ModelSettings.temperature)
# Default: 0.7
# Range: 0.0-2.0
LLM_TEMPERATURE=0.7

# Timeout in seconds for entire RAG workflow execution
# Covers all steps combined (search + evaluate + synthesize)
# Default: 60
# Range: 5-600
RAG_WORKFLOW_TIMEOUT=60

# Time-to-live in seconds for RAG query result cache
# Cache stores workflow results to avoid redundant LLM calls
# Set to 0 to disable caching
# Default: 300 (5 minutes)
# Range: 0-3600
RAG_CACHE_TTL=300

# Maximum number of entries in RAG query result cache
# Uses LRU eviction when limit is reached
# Default: 100
# Range: 1-10000
RAG_CACHE_SIZE=100

# Number of hits to retrieve on the initial CRAG search attempt
# Default: 2
RAG_INITIAL_K=2

# Number of hits to retrieve on a CRAG retry after insufficient grading
# Widened from RAG_INITIAL_K to broaden context on retry
# Default: 4
RAG_WIDENED_K=4

# Maximum number of SSE events emitted per agent stream request
# Stream stops producing further events once this cap is reached
# Default: 1000
SSE_MAX_EVENTS=1000

# Interval in seconds between SSE heartbeat comments emitted
# while the agent stream is idle (no event ready to send)
# Default: 15
# Note: Must not exceed SSE_SEND_TIMEOUT
SSE_HEARTBEAT_INTERVAL=15

# Timeout in seconds for producing a single SSE event
# Stream aborts with a terminal error event if exceeded
# Default: 60
SSE_SEND_TIMEOUT=60

# HTTP client timeout in seconds
# Default: 30.0
HTTP_TIMEOUT=30.0

# HTTP client connection timeout in seconds
# Default: 5.0
HTTP_CONNECT_TIMEOUT=5.0

# Maximum number of HTTP connections in the pool
# Default: 100
# Range: 1-500
HTTP_MAX_CONNECTIONS=100

# Maximum number of keep-alive HTTP connections in the pool
# Default: 20
# Range: 1-100
# Note: Must not exceed HTTP_MAX_CONNECTIONS
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Maximum retry attempts for HTTP client requests on transient failures
# Network errors and 5xx server errors trigger retries with exponential backoff
# Default: 3
# Range: 1-10
HTTP_RETRY_MAX_ATTEMPTS=3

# Base delay in seconds for exponential backoff retries in HTTP client
# Actual delay: base_delay * (2 ** attempt) + random jitter
# Default: 1.0
# Range: 0.1-10.0
HTTP_RETRY_BASE_DELAY=1.0

# ============================================================================
# REDIS SESSION STORE ()
# ============================================================================
# Enable Redis-backed session store for multi-instance deployments
# If disabled or not configured, uses in-memory session store
# In-memory store is suitable for development and single-instance deployments only

# Redis connection URL
# Format: redis://[user:password@]host:port/db
# Examples:
#   Local Redis: redis://localhost:6379/0
#   Redis with auth: redis://:password@localhost:6379/0
#   Redis Cloud: redis://:password@redis-12345.cloud.redislabs.com:12345/0
# Leave empty to use in-memory session store
REDIS_URL=

# Enable Redis session store
# Set to true to use Redis for session storage (requires REDIS_URL to be set)
# Set to false to use in-memory session store (default)
# Default: false
REDIS_SESSION_STORE_ENABLED=false

# ============================================================================
# OBSERVABILITY
# ============================================================================

# Pydantic Logfire token for observability
# Get your token from https://logfire.pydantic.dev/
# Leave empty to disable Logfire integration
LOGFIRE_TOKEN=

# Service name for Logfire traces
# Default: fastapi-pydantic-ai-agent
LOGFIRE_SERVICE_NAME=fastapi-pydantic-ai-agent

# Disable Logfire scrubbing of prompt/tool_input/tool_output payloads.
# For local debugging only - emits an audit warning when enabled.
# Default: false
LOG_SENSITIVE_PAYLOADS=false

# ============================================================================
# OLLAMA LOCAL DEVELOPMENT (Optional)
# ============================================================================
# Use Ollama as a local LLM provider (no API key required)
#
# 1. Install Ollama: https://ollama.com
# 2. Start server: ollama serve
# 3. Pull models:
#    ollama pull granite3.3:latest
#    ollama pull granite3.3:latest
#    ollama pull nomic-embed-text:latest  # for OllamaEmbeddingVectorStore
#
# Example LLM configuration with Ollama:
# LLM_MODEL=ollama:granite3.3:latest
# LLM_BASE_URL=http://localhost:11434  # Optional, WITHOUT /v1 (LiteLLM adds it)
# LLM_API_KEY is NOT required for Ollama (local provider)
#
# Example embedding configuration (enables semantic search):
# EMBEDDING_MODEL=nomic-embed-text:latest
# EMBEDDING_BASE_URL=http://localhost:11434/v1  # WITH /v1 (direct API call, no LiteLLM)
#
# Note the URL difference:
#   - LLM_BASE_URL: no /v1 (LiteLLM appends it automatically)
#   - EMBEDDING_BASE_URL: with /v1 (calls Ollama API directly, not via LiteLLM)
#
# Note: When using Ollama, the LLM_MODEL format is "ollama:<model>:<tag>"
# Examples:
#   - ollama:granite3.3:latest
#   - ollama:granite3.3:latest
#   - ollama:llama3.2